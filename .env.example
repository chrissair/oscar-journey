# Copy this file to `.env` and fill in the values.
# `.env` is gitignored — never commit real keys.

# TMDB (The Movie Database) — used for series/collection backfill scripts
# https://www.themoviedb.org/settings/api
TMDB_API_KEY=
TMDB_READ_TOKEN=

# Firebase (client SDK config — ships to browser in build output)
# Not true secrets; real security comes from Firestore rules + API key restrictions
# in Google Cloud Console. Grab these from:
# https://console.firebase.google.com/project/<your-project>/settings/general
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
